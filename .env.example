# Copy to `.env` next to compose.yaml — docker compose reads it automatically:
#   cp .env.example .env
#
# `.env` is gitignored. It holds the WhatsApp gateway credential.
#
# Every variable below has a default in compose.yaml, so the stack starts
# without a .env at all — attendance forwarding is simply off.

# --- Attendance forwarding -------------------------------------------------
# Pushes each face-attendance punch to erina's absensi table and to the
# WhatsApp gateway, which batches a per-class report to a WhatsApp group at a
# scheduled time. Delivery state is kept per row, so an outage in either
# system is retried rather than dropped.
#
# Leave false until both URLs below are reachable from this host.
FORWARD_ENABLED=false

# Background worker cadence and batch size.
FORWARD_INTERVAL_SECONDS=30
FORWARD_BATCH_SIZE=50

# Give up on a punch after this many failed passes. The row stays in the hub
# with forward_error set; only the outbound push is abandoned.
FORWARD_MAX_ATTEMPTS=10

# Never deliver punches older than this — that day's report has already gone out.
FORWARD_MAX_AGE_HOURS=72

# --- erina (app-erina-api) -------------------------------------------------
# erina runs on the prod box; reach it over Tailscale. Port 9050 direct, or the
# https Traefik hostname.
ERINA_BASE_URL=http://100.x.y.z:9050

# erina's only gate is a User-Agent / X-App-Client allowlist. Its own source
# calls this "trivially spoofable... NOT real authentication".
ERINA_APP_CLIENT=erina-admin

# Written to absensi.tipe. Anything other than PULANG reads as an arrival in
# erina's queries — leave as-is unless erina changes.
ERINA_ATTENDANCE_TIPE=HADIR

# Cache lifetime for cbt_user_id -> erina {id, class_id}. Only changes when a
# student is re-synced from zyacbt.
ERINA_CACHE_TTL_HOURS=12

# --- WhatsApp gateway (qr-anshar-wa-gateway-v2) ----------------------------
WA_BASE_URL=https://wa-gateway

# The gateway creates this account on startup with role "shinkaimon-hub". Its
# default password is the same as the username — change it in the gateway's
# user admin and update it here.
WA_USERNAME=shinkaimon-hub-service
WA_PASSWORD=shinkaimon-hub-service
